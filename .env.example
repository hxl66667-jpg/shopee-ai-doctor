# Supabase browser configuration. Prefer the new publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy compatibility only. If this is already configured in Vercel, V2.1 can still use it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional server-side AI layer. Never expose this in NEXT_PUBLIC_* variables.
OPENAI_API_KEY=
